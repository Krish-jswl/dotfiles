
* {
    /* Rosé Pine Moon */
    base    : #232136;
    surface : #2a273f;
    overlay : #393552;
    hl-med  : #44415a;
    muted   : #6e6a86;
    subtle  : #908caa;
    text    : #e0def4;
    love    : #eb6f92;
    gold    : #f6c177;
    rose    : #ea9a97;
    pine    : #3e8fb0;
    foam    : #9ccfd8;
    iris    : #c4a7e7;

    background-color:   transparent;
    text-color:          @text;

    font: "Iosevka Nerd Font 12";
}

window {
    background-color: @base;
    border:           2px;
    border-color:     @pine;
    border-radius:    3px;
    width:            400px;
    location:         center;
    padding:          0;
}

mainbox {
    background-color: transparent;
    padding: 10px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @surface;
    text-color:       @text;
    border-radius:    4px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @foam;
    font:             "Iosevka Nerd Font Bold 12";
    padding:          0 8px 0 0;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search...";
    placeholder-color: @muted;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @subtle;
    padding:          8px 12px;
    border-radius:    4px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @subtle;
}

element selected.normal {
    background-color: @overlay;
    text-color:       @foam;
    border:           1px;
    border-color:     @pine;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @subtle;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             24px;
    padding:          0 10px 0 0;
}

message {
    background-color: @surface;
    border-radius:    4px;
    padding:          8px;
    margin:           0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:       @text;
}

error-message {
    background-color: @base;
    text-color:       @love;
    border:           2px;
    border-color:     @love;
    border-radius:    6px;
    padding:          12px;
}
