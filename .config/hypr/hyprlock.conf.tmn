# BACKGROUND
background {
    monitor =
    path = screenshot

    blur_passes = 2
    contrast = 1
    brightness = 0.75
    vibrancy = 0.15
    vibrancy_darkness = 0.25
}

# GENERAL
general {
    hide_cursor = true
    ignore_empty_input = true
}

# INPUT FIELD
input-field {
    monitor =
    size = 250, 50
    outline_thickness = 3
    dots_size = 0.33
    dots_spacing = 0.15
    dots_center = true

    # Tomorrow Night Palette
    # Accent: #f0c674 | Bg: #1d1f21 | Font: #c5c8c6
    outer_color = rgba(240, 198, 116, 0.9)   # f0c674 accent
    inner_color = rgba(29, 31, 33, 0.85)     # Background
    font_color = rgb(197, 200, 198)          # Foreground

    font_family = JetBrainsMono Nerd Font Mono
    fade_on_empty = true
    rounding = 12

    check_color = rgb(181, 189, 104)         # Tomorrow Green
    fail_color = rgb(204, 102, 102)          # Tomorrow Red

    fail_text = Incorrect
    placeholder_text = Password...

    hide_input = false
    position = 0, -200
    halign = center
    valign = center
}

# TIME
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"

    color = rgba(197, 200, 198, 0.95)       # Foreground White
    font_size = 120
    font_family = JetBrainsMono Nerd Font Bold

    position = 0, 80
    halign = center
    valign = center
}

# DATE
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A, %d %B")"
    color = rgba(240, 198, 116, 0.8)        # Accent Yellow
    font_size = 24
    font_family = JetBrainsMono Nerd Font

    position = 0, -10
    halign = center
    valign = center
}
